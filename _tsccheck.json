{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["react", "react-dom"]
  },
  "include": [
    "src/vite-env.d.ts",
    "src/components/editor/monacoTheme.ts",
    "src/components/editor/CodeEditor.tsx",
    "src/components/editor/ObjectLayer.tsx",
    "src/components/editor/sqd.ts",
    "src/components/editor/shapes.ts"
  ]
}
